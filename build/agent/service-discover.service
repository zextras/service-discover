[Unit]
Description=Zextras Service Discover Agent
Documentation=https://docs.zextras.com/
Requires=network-online.target
# carbonio-openldap.service: same-node restart ordering only (no-op where absent)
After=network-online.target carbonio-openldap.service
PartOf=service-discover.target

[Service]
Type=notify
ExecStart=/usr/bin/service-discoverd agent
# On a node using SPIRE: obtain the credentials of the installed Carbonio services and register them. It does nothing
# elsewhere. Failures are not fatal, the command can be run again. --no-block: the units to restart start after this one.
ExecStartPost=-/usr/bin/service-discover service sync --no-block --wait 10s
Restart=on-failure
RestartSec=15s
# consul exits 1 when stopped without leaving the cluster; a requested stop is
# never restarted, so a crash with exit 1 is still restarted
SuccessExitStatus=1
RestartForceExitStatus=1
KillMode=process
LimitNOFILE=65536
ExecReload=/usr/bin/consul reload
TimeoutSec=120s
TimeoutStopSec=120s

# Hardening
PrivateTmp=yes
#ProtectSystem=strict
#ReadWritePaths=/var/lib/service-discover /etc/zextras/service-discover /run/carbonio /tmp
ProtectSystem=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=service-discover.target
