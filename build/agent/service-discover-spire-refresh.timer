[Unit]
Description=Zextras Service Discover: daily refresh of the SPIRE servers of the agent
Documentation=https://docs.zextras.com/

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
