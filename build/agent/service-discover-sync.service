[Unit]
Description=Zextras Service Discover registration of the installed services
Documentation=https://docs.zextras.com/
After=service-discover.service
# Not started again for every file a package unpacks: the path unit triggers it as many times as needed. The run
# starts at the first file and --settle waits for the others: the events of the files unpacked during a run are lost.
StartLimitIntervalSec=0

[Service]
Type=oneshot
# On a node using SPIRE: obtain the credentials of the services installed since the last run and register them. It does
# nothing elsewhere, and nothing when nothing changed.
ExecStart=/usr/bin/service-discover service sync --no-block --wait 10s --settle 2s
# The status 75 (EX_TEMPFAIL) is a service whose definition the servers have not applied yet: they do when they get the
# service-discover-specs package, and the run is started again until they did. Any other failure is not run again.
Restart=no
RestartForceExitStatus=75
RestartSec=60
