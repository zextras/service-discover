_install_refresh_timer() {
  install -Dm644 service-discover-spire-refresh.service \
    "${pkgdir}/lib/systemd/system/service-discover-spire-refresh.service"
  install -Dm644 service-discover-spire-refresh.timer \
    "${pkgdir}/lib/systemd/system/service-discover-spire-refresh.timer"
}

_package_legacy() {
  cd "${srcdir}"
  install -Dm755 agent \
    "${pkgdir}/usr/bin/service-discover"
  install -Dm644 service-discover-legacy.service \
    "${pkgdir}/lib/systemd/system/service-discover.service"
  _install_refresh_timer
}

_package_systemd() {
  cd "${srcdir}"
  install -Dm755 agent \
    "${pkgdir}/usr/bin/service-discover"
  install -Dm644 service-discover.service \
    "${pkgdir}/lib/systemd/system/service-discover.service"
  _install_refresh_timer
  install -Dm644 service-discover-sync.service \
    "${pkgdir}/lib/systemd/system/service-discover-sync.service"
  install -Dm644 service-discover-sync.path \
    "${pkgdir}/lib/systemd/system/service-discover-sync.path"
}

build() {
  cd "${repodir}"
  CGO_ENABLED=0 go build \
    -o "${srcdir}/agent" \
    cmd/agent/agent.go
}

package() {
  _package_systemd
}

package__rocky_8() {
  _package_legacy
}

package__rocky_9() {
  _package_systemd
}

package__ubuntu_jammy() {
  _package_legacy
}

package__ubuntu_noble() {
  _package_systemd
}

postinst__apt() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload &>/dev/null || :
    # Enable on both fresh install and upgrade so the [Install] WantedBy=
    # symlink is always reconciled against the current unit (self-healing).
    if [ "$1" = "configure" ]; then
      systemctl enable service-discover.service &>/dev/null || :
      systemctl enable --now service-discover-spire-refresh.timer &>/dev/null || :
      systemctl enable --now service-discover-sync.path &>/dev/null || :
    fi
  fi

  echo "Installed, run service-discover setup-wizard on first installation."
}

postinst__yum() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload &>/dev/null || :
    # Enable on both fresh install ($1 -eq 1) and upgrade ($1 -eq 2) so the
    # [Install] WantedBy= symlink is always reconciled (self-healing).
    if [ $1 -ge 1 ]; then
      systemctl enable service-discover.service &>/dev/null || :
      systemctl enable --now service-discover-spire-refresh.timer &>/dev/null || :
      systemctl enable --now service-discover-sync.path &>/dev/null || :
    fi
  fi

  echo "Installed, run service-discover setup-wizard on first installation."
}

postrm() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
  fi
}

prerm__apt() {
  if [ -d /run/systemd/system ]; then
    case "$1" in
      remove)
        systemctl --no-reload disable --now service-discover-sync.path &>/dev/null || :
        systemctl --no-reload disable --now service-discover-spire-refresh.timer &>/dev/null || :
        systemctl --no-reload disable --now service-discover.service &>/dev/null || :
        ;;
      upgrade)
        systemctl --no-reload stop service-discover.service &>/dev/null || :
        ;;
    esac
  fi
}

prerm__yum() {
  if [ -d /run/systemd/system ]; then
    if [ $1 -eq 0 ]; then
      systemctl --no-reload disable --now service-discover-sync.path &>/dev/null || :
      systemctl --no-reload disable --now service-discover-spire-refresh.timer &>/dev/null || :
      systemctl --no-reload disable --now service-discover.service &>/dev/null || :
    else
      systemctl --no-reload stop service-discover.service &>/dev/null || :
    fi
  fi
}
