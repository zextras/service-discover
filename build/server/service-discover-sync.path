[Unit]
Description=Zextras Service Discover watch of the service definitions of the packages
Documentation=https://docs.zextras.com/
PartOf=service-discover.target

[Path]
# A package installed after service-discover started puts its service definition here.
PathChanged=/etc/zextras/service-discover
Unit=service-discover-sync.service

[Install]
WantedBy=service-discover.target
